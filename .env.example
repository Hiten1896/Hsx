ANTHROPIC_API_KEY=your_key_here
HSX_MODEL=claude-sonnet-4-6
HSX_PROVIDER=anthropic
HSX_FALLBACKS=ollama
# Set HSX_PANEL_MODE=auto to use two drafts plus a judge for text-only responses.
HSX_PANEL_MODE=off
HSX_PANEL_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Optional OpenRouter free-model access; keep the key local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Optional OpenAI-compatible endpoint (for example another hosted free tier).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_URL=
OLLAMA_URL=http://127.0.0.1:11434
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
HSX_HOST=127.0.0.1
HSX_PORT=8000
# On Debian, the defaults are /home/hsxshare and "Hsx Work".
# Windows development defaults to the repository directory to preserve local workflows.
# HSX_WORKSPACE=/home/hsxshare
# HSX_WORK_DIR=Hsx Work
# Optional quiet period, local server time, formatted HH:MM-HH:MM.
HSX_QUIET_HOURS=
# all sends to every registered device; recent targets only the most recently active device.
HSX_WEBPUSH_TARGET_MODE=all
# Per-event routing examples: inapp,webpush,telegram (channels may be omitted).
# HSX_NOTIFY_JOB_DONE=inapp,webpush
# HSX_NOTIFY_NEEDS_INPUT=inapp,webpush
# HSX_NOTIFY_NEEDS_APPROVAL=inapp,webpush
# HSX_NOTIFY_JOB_FAILED=inapp,webpush
# HSX_NOTIFY_HEALTH_ALERT=inapp,webpush,telegram
# HSX_NOTIFY_HEARTBEAT=telegram
# Generated into the root:hsx 0640 secrets file by deploy/generate-vapid.sh.
HSX_VAPID_PUBLIC_KEY=
HSX_VAPID_PRIVATE_KEY=
# Optional; a token is generated and stored in data/auth.token when omitted.
HSX_AUTH_TOKEN=
# Optional setup PIN; otherwise a random owner PIN is generated and printed once.
HSX_OWNER_PIN=
# Dangerous system-control skills require explicit owner approval. Set either value to 1
# for trusted local administration when you intentionally want bypass behavior.
HSX_ALLOW_DANGEROUS=0
HSX_ALLOW_SYSTEM_CONTROL=0
# Comma-separated browser origins allowed to call the API.
HSX_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# auto selects Docker when available, otherwise the weaker subprocess fallback.
HSX_SANDBOX=auto