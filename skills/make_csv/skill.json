{
  "name": "make_csv",
  "description": "Creates a CSV file from headers and rows of data.",
  "input_schema": {
    "type": "object",
    "properties": {
      "filename": {
        "type": "string"
      },
      "headers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rows": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "filename",
      "headers",
      "rows"
    ]
  }
}