ANTHROPIC_API_KEY=your_key_here
HSX_MODEL=claude-sonnet-4-6
HSX_HOST=127.0.0.1
HSX_PORT=8000
# Required when HSX_HOST is not a loopback address.
HSX_AUTH_TOKEN=
# Comma-separated browser origins allowed to call the API.
HSX_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# auto selects Docker when available, otherwise the weaker subprocess fallback.
HSX_SANDBOX=auto