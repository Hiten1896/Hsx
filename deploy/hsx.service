[Unit]
Description=Hsx local AI agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hsx
WorkingDirectory=/opt/hsx
EnvironmentFile=/opt/hsx/.env
EnvironmentFile=-/etc/hsx/secrets.env
Environment=HSX_VENV_DIR=/opt/hsx/venv
ExecStart=/bin/bash /opt/hsx/scripts/run_hsx.sh
Restart=on-failure
RestartSec=5
MemoryHigh=1400M
MemoryMax=1536M
StandardOutput=append:/opt/hsx/logs/hsx_service.log
StandardError=append:/opt/hsx/logs/hsx_service.log
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
