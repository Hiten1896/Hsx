{
  "name": "download_media",
  "description": "Queue a media download from a URL into the outputs directory.",
  "input_schema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string"
      },
      "filename": {
        "type": "string"
      },
      "max_duration_seconds": {
        "type": "integer"
      },
      "max_size_mb": {
        "type": "integer"
      }
    },
    "required": [
      "url"
    ]
  }
}