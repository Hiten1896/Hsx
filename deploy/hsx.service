[Unit]
Description=Hsx local AI agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hsx
WorkingDirectory=/opt/hsx
EnvironmentFile=-/etc/hsx/secrets.env
Environment=HSX_VENV_DIR=/opt/hsx/.venv
ExecStart=/opt/hsx/scripts/run_hsx.sh
Restart=always
RestartSec=5
StandardOutput=append:/opt/hsx/logs/hsx_service.log
StandardError=append:/opt/hsx/logs/hsx_service.log
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
