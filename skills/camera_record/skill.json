{
  "name": "camera_record",
  "description": "Capture a snapshot or short video from the local host camera, or request a user-confirmed capture from the browser camera.",
  "input_schema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "snapshot",
          "video"
        ]
      },
      "duration_seconds": {
        "type": "integer"
      },
      "filename": {
        "type": "string"
      },
      "target_device": {
        "type": "string",
        "enum": [
          "local_host",
          "client_browser"
        ]
      }
    },
    "required": [
      "mode"
    ]
  }
}