ANTHROPIC_API_KEY=
HSX_MODEL=claude-sonnet-4-6
HSX_PROVIDER=
HSX_FALLBACKS=
# Set HSX_PANEL_MODE=auto to use two drafts plus a judge for text-only responses.
HSX_PANEL_MODE=off
HSX_PANEL_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Optional OpenRouter free-model access; keep the key local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Optional OpenAI-compatible endpoint (for example another hosted free tier).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_URL=
OLLAMA_URL=http://127.0.0.1:11434
# Set OLLAMA_MODEL to add the local Ollama provider to bandit selection.
OLLAMA_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
HSX_HOST=127.0.0.1
HSX_PORT=8000
# On Debian, the defaults are /home/hsxshare and "Hsx Work".
# Windows development defaults to the repository directory to preserve local workflows.
# HSX_WORKSPACE=/home/hsxshare
# HSX_WORK_DIR="Hsx Work"
# Optional quiet period, local server time, formatted HH:MM-HH:MM.
HSX_QUIET_HOURS=
# all sends to every registered device; recent targets only the most recently active device.
HSX_WEBPUSH_TARGET_MODE=all
# Per-event routing examples: inapp,webpush,telegram (channels may be omitted).
# HSX_NOTIFY_JOB_DONE=inapp,webpush
# HSX_NOTIFY_NEEDS_INPUT=inapp,webpush
# HSX_NOTIFY_NEEDS_APPROVAL=inapp,webpush
# HSX_NOTIFY_JOB_FAILED=inapp,webpush
# HSX_NOTIFY_HEALTH_ALERT=inapp,webpush,telegram
# HSX_NOTIFY_HEARTBEAT=telegram
# Generated into the root:hsx 0640 secrets file by deploy/generate-vapid.sh.
HSX_VAPID_PUBLIC_KEY=
HSX_VAPID_PRIVATE_KEY=
# Optional; a token is generated and stored in data/auth.token when omitted.
HSX_AUTH_TOKEN=
# Optional setup PIN; otherwise a random owner PIN is generated and printed once.
HSX_OWNER_PIN=
# Voice capture is opt-in. The listener waits for this phrase and does not retain audio.
HSX_ENABLE_VOICE_LISTENER=0
HSX_VOICE_WAKE_PHRASE="hey hsx"
HSX_VOICE_MODEL_PATH=./models/vosk-model-small-en-us-0.15
# Optional mpv ALSA output device; use `mpv --audio-device=help` to list available devices.
HSX_AUDIO_DEVICE=alsa/default
# The dashboard camera starts with the web server unless an optional direct-device
# RTSP or Motion mode is selected. Vision capture and audio playback remain opt-in.
# The RTSP target must be an existing private-network server (for example, MediaMTX).
HSX_CAMERA_DEVICE=/dev/video0
HSX_ENABLE_CAMERA_STREAM=0
HSX_RTSP_URL=
HSX_ENABLE_MOTION_MONITOR=0
HSX_ENABLE_VISION_CAPTURE=0
HSX_ENABLE_AUDIO_ALERTS=0
HSX_ENABLE_VOICE_ALERTS=0
HSX_PIPER_MODEL=
HSX_AUDIO_ALERT_RAM_PERCENT=90
HSX_AUDIO_ALERT_CPU_PERCENT=95
# Dangerous system-control skills require explicit owner approval. Set either value to 1
# for trusted local administration when you intentionally want bypass behavior.
HSX_ALLOW_DANGEROUS=0
HSX_ALLOW_SYSTEM_CONTROL=0
# Comma-separated browser origins allowed to call the API.
HSX_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# auto selects Docker when available, otherwise the weaker subprocess fallback.
HSX_SANDBOX=auto
# Automatic source updates are disabled until explicitly enabled and a trusted GPG
# signer fingerprint is configured. Updates are fast-forward-only from the selected branch.
HSX_AUTO_UPDATE=0
HSX_UPDATE_BRANCH=main
HSX_UPDATE_REMOTE=https://github.com/Hiten1896/Hsx.git
# HSX_UPDATE_SIGNER_FINGERPRINT=40_OR_64_CHARACTER_GPG_SIGNING_KEY_FINGERPRINT
